# Application
PREVIS_APP_NAME="FrameForge Pre-Visualization Engine"
PREVIS_DATABASE_PATH="./data/previs.db"
PREVIS_CORS_ORIGINS=""

# Shot planning: auto | openai | deterministic
# auto uses OpenAI when configured and safely falls back to the local planner.
PREVIS_PLANNER_MODE="auto"
PREVIS_OPENAI_MODEL="gpt-5-mini"
OPENAI_API_KEY=""
OPENAI_API_BASE="https://api.openai.com/v1"

# Rendering: simulated | higgsfield
PREVIS_RENDER_PROVIDER="simulated"
PREVIS_RENDER_CONCURRENCY="3"
PREVIS_SIMULATION_DELAY_SECONDS="1.2"

# Higgsfield's model payloads and endpoint URLs may vary by account/model.
# Configure these from https://docs.higgsfield.ai/docs before selecting higgsfield.
HIGGSFIELD_API_KEY=""
HIGGSFIELD_SUBMIT_URL=""
HIGGSFIELD_STATUS_URL_TEMPLATE=""
HIGGSFIELD_MODEL="seedance_2_5"
HIGGSFIELD_POLL_INTERVAL_SECONDS="4"
HIGGSFIELD_MAX_POLLS="90"
