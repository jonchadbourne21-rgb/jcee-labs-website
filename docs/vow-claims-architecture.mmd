flowchart TB
  subgraph clients[Claims Experience]
    UI[Next.js Homeowner Intake and Adjuster Cockpit]
  end

  subgraph edge[Service Edge]
    EDGE[TLS / Authentication / Rate Limits]
  end

  subgraph claims[Claims Service Boundary]
    API[FastAPI Claims API]
    PRICE[Deterministic Pricing Engine]
    REVIEW[Adjuster Review Decision]
    WRAP[VOW Integration Wrapper]
  end

  subgraph vow[VOW-Controlled Assurance Boundary]
    CORE[Frozen VOW 1.1 Parser / Transpiler / Runtime]
    PROOF[Authorization and Proof Gate]
    CAP[Deontic Capability Gate]
    ADAPTER[Settlement Effect Adapter]
    RECOVERY[Recovery Worker / Sweeper]
  end

  subgraph effects[Effect Destinations]
    OUTBOX[Local Settlement Intent Outbox]
    PAYMENT[Future Payment Provider]
  end

  subgraph evidence[Persistence and Evidence]
    CLAIMS[Claim Dossier Store]
    JOURNAL[Durable Hash-Chained Journal]
    STATE[Run / State Store]
    SCARS[Scar Memory]
    EFFECTS[Effect Records]
    RECEIPTS[Signed Receipt / Evidence Packs]
  end

  VERIFY[Independent VOW Evidence Verifier]

  UI --> EDGE --> API
  API --> PRICE --> CLAIMS
  API --> REVIEW
  REVIEW --> WRAP --> CORE --> PROOF --> CAP --> ADAPTER
  ADAPTER --> OUTBOX
  ADAPTER -. future provider-specific adapter .-> PAYMENT
  OUTBOX --> EFFECTS
  PAYMENT --> EFFECTS
  CORE --> JOURNAL
  CORE --> STATE
  CORE --> SCARS
  EFFECTS --> RECEIPTS
  JOURNAL --> RECEIPTS
  STATE --> RECEIPTS
  SCARS --> RECEIPTS
  RECOVERY --> CORE
  RECOVERY --> JOURNAL
  RECEIPTS --> VERIFY
  VERIFY -. verification result .-> API

