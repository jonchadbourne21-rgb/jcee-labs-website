  class UI,EDGE,API,PRICE,REVIEW,WRAP app;
  class CORE,PROOF,CAP,ADAPTER,RECOVERY,VERIFY gate;
  class OUTBOX,PAYMENT effect;
  class CLAIMS,JOURNAL,STATE,SCARS,EFFECTS,RECEIPTS store;
