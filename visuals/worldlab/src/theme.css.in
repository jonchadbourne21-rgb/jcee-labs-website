/* GENERATED by visuals/worldlab. Edit src/theme.css.in, then run pnpm visuals:generate. */
:root {
  --jcee-paper:{{BG}}; --jcee-ink:{{INK}}; --jcee-muted:{{MUTED}}; --jcee-line:{{LINE}};
  --wl-bg:{{BG}}; --wl-ink:{{INK}}; --wl-muted:{{MUTED}}; --wl-line:{{LINE}}; --wl-green:{{ACCENT}};
  --worldlab-font:'DM Sans',Arial,sans-serif; --wl-display:'Space Grotesk',Arial,sans-serif;
  --worldlab-bronze:{{ACCENT}}; --worldlab-surface:{{SURFACE}};
  --jcee-blue:{{ACCENT}}; --jcee-navy:{{ACCENT}}; --jcee-lift:none;
}
#root .site-header:not(.integrated-header) {
  background:#080a09f5 !important;
  border-bottom:0 !important; padding-inline:clamp(22px,5vw,72px) !important;
}
#root .site-header .wordmark { font-size:20px !important; letter-spacing:.035em !important; text-decoration:none; }
#root .site-header .wordmark span { font-size:inherit; letter-spacing:inherit; }
#root .site-header .desktop-nav { align-items:center; gap:28px !important; }
#root .site-header .desktop-nav a,
#root .site-header .header-company-menu summary { color:var(--jcee-ink) !important; font:400 14px/1.4 var(--worldlab-font) !important; letter-spacing:0 !important; }
#root .site-header .header-contact { border:0 !important; padding:12px 0 !important; color:var(--jcee-ink) !important; }
.header-company-menu { position:relative; }
.header-company-menu summary { cursor:pointer; list-style:none; padding:12px 8px; }
.header-company-menu summary::-webkit-details-marker { display:none; }
.header-company-links { position:absolute; right:0; top:100%; min-width:220px; padding:10px; background:var(--jcee-paper); border:1px solid var(--jcee-line); border-radius:8px; box-shadow:0 12px 32px #0004; }
#root .site-header .header-company-links a { display:block; padding:12px !important; }
.header-company-links a:hover { background:var(--worldlab-surface); }
.header-company-menu summary:focus-visible { outline:2px solid var(--worldlab-bronze); outline-offset:3px; }
#root :is(.editorial-page,.program-page,.paper-page,.legal-page,.preview-consultation-page) {
  font-family:var(--worldlab-font);
  --editorial-blue:var(--worldlab-bronze); --signal:var(--worldlab-bronze);
}
#root :is(.editorial-page,.program-page,.paper-page,.legal-page) :is(h1,h2,h3) {
  font-family:inherit !important; color:var(--jcee-ink) !important;
  text-shadow:var(--jcee-lift) !important; letter-spacing:-.025em;
}
#root :is(.editorial-page,.program-page,.paper-page,.legal-page) :is(p,li,small) { color:var(--jcee-muted); }
#root :is(.editorial-page,.program-page,.paper-page) :is(.editorial-kicker,.eyebrow,.program-number,.partner-kicker,.registry-kicker,.charter-section-label) { color:var(--worldlab-bronze) !important; }
#root .editorial-page .editorial-masthead { padding:72px clamp(22px,5vw,72px) 64px; max-width:1440px; margin-inline:auto; }
#root .editorial-page .editorial-section { padding:56px clamp(22px,5vw,72px); max-width:1440px; margin-inline:auto; }
#root .editorial-page .editorial-masthead h1 { font-size:clamp(38px,4.8vw,70px); line-height:1.08; }
#root .editorial-page .editorial-deck { font-size:clamp(17px,1.5vw,21px); line-height:1.65; max-width:58ch; }
#root .brand-footer { background:var(--jcee-paper) !important; color:var(--jcee-ink) !important; }
#root .brand-footer-links > div > span { color:var(--worldlab-bronze) !important; }
#root .brand-footer :is(a,strong,.brand-footer-wordmark) { color:var(--jcee-ink) !important; }
#root .brand-footer .brand-footer-wordmark { font-family:inherit !important; font-weight:600; text-shadow:var(--jcee-lift) !important; }
@media(min-width:901px) and (max-width:1100px) {
 #root .site-header .desktop-nav { gap:12px !important; }
 #root .site-header .wordmark { font-size:17px !important; }
}
@media(max-width:700px) {
 #root .site-header .wordmark { font-size:16px !important; letter-spacing:.015em !important; gap:8px; }
 #root .site-header .header-contact { font-size:13px !important; }
 #root .editorial-page .editorial-masthead { padding-top:44px; gap:24px; }
 #root .editorial-page .editorial-section { padding-block:36px; }
}
@media(max-width:360px) { #root .site-header .wordmark { font-size:14px !important; gap:5px; } }

#root .editorial-page .editorial-link-list a { color:var(--jcee-ink) !important; border-color:var(--jcee-line) !important; }
#root .editorial-page .editorial-link-list a span { color:var(--jcee-muted) !important; }

/* Full-page and subcategory cleanup: shared prose, records and controls. */
#root :is(.editorial-page,.program-page,.paper-page,.charter-page) {
  --muted:var(--jcee-muted); --line:var(--jcee-line); --white:var(--jcee-ink);
}
#root :is(.editorial-page,.program-page) :is(.publication-toc a,.publication-body footer a,.build-status-list a,.editorial-text-link,.research-status-line,.registry-entry-index,.partner-pathway-code,.binding-strip li > span,.research-field-heading > span,.physical-program dt,.infra-stage__status,.founder-monogram,.section-index,.eyebrow > span) { color:var(--worldlab-bronze) !important; }
#root .editorial-page :is(.founder-identity dt,.founder-work-index,.evidence-ladder__note,.publication-body,.publication-toc nav a) { color:var(--jcee-muted) !important; }
#root .editorial-page .resource-filters button { color:var(--jcee-ink); border-color:var(--jcee-line); border-radius:6px; }
#root .editorial-page .resource-filters button[aria-pressed="true"] { background:var(--jcee-ink); color:var(--jcee-paper); border-color:var(--jcee-ink); }
#root :is(.editorial-page,.program-page) .status-label { background:var(--worldlab-surface); color:var(--jcee-ink); border-color:var(--jcee-line); }
#root :is(.editorial-page,.program-page) :is(table,th,td,blockquote,.publication-toc,.research-topic-nav,.physical-program dl > div,.binding-strip li) { border-color:var(--jcee-line) !important; }
#root .customer-home .customer-demo :is(.et-mono,.et-eyebrow,.et-trace-index) { color:var(--worldlab-bronze) !important; }
/* Read-only archived wording is preserved, presented in the current site shell. */
#root .charter-page,
#root .charter-page :is(.charter-masthead,.charter-shell,.charter-document,.charter-signoff,.charter-toc) { background:var(--jcee-paper) !important; color:var(--jcee-ink) !important; font-family:var(--worldlab-font); }
#root .charter-page :is(h1,h2,h3,em,strong) { color:var(--jcee-ink) !important; font-family:inherit !important; text-shadow:var(--jcee-lift); font-style:normal; }
#root .charter-page :is(p,li,dd) { color:var(--jcee-muted) !important; }
#root .charter-page :is(a,dt,.eyebrow,.charter-section-label) { color:var(--worldlab-bronze) !important; }
#root .charter-page .charter-title { font-size:clamp(40px,5vw,76px); }
/* Functional illustrations retain their controls and explicit state words. */
#root .program-page :is(.qcs-gate,.durability-console) { background:var(--worldlab-surface) !important; border-color:var(--jcee-line) !important; color:var(--jcee-ink) !important; border-radius:10px; }
#root .program-page :is(.qcs-gate,.durability-console) :is(h2,h3,p,li,dd,span,div,i,strong) { color:var(--jcee-ink) !important; text-shadow:none !important; border-color:var(--jcee-line) !important; }
#root .program-page :is(.qcs-gate__state,.qcs-gate__decision,.qcs-gate__state span,.machine-row,.durability-sidecar) { background:var(--jcee-paper) !important; }
#root .program-page :is(.qcs-gate,.durability-console) button { background:var(--jcee-paper) !important; color:var(--jcee-ink) !important; border-color:var(--jcee-muted) !important; }
#root .program-page :is(.qcs-gate,.durability-console) button:focus-visible { outline:3px solid var(--worldlab-bronze); outline-offset:3px; }
#root .jcee-editorial { --ink:var(--jcee-ink); --muted:var(--jcee-muted); --accent:var(--worldlab-bronze); --line:var(--jcee-line); }
#root .jcee-editorial :is(h1,h2,h3) { font-family:var(--worldlab-font); color:var(--jcee-ink); text-shadow:var(--jcee-lift); }
#root .jcee-editorial .site-header { display:flex; }
#root .charter-page .charter-masthead { min-height:0 !important; padding-block:56px !important; }
#root .charter-page :is(h1,h2,h3) { font-weight:600 !important; }
#root .charter-page :is(.eyebrow > span,.charter-version-row span::before) { background:var(--worldlab-bronze) !important; }
#root .charter-page .charter-archive-notice { margin:0; padding:20px clamp(22px,4vw,64px); border-bottom:1px solid var(--jcee-line); font-size:14px; }

/* Material-led identity: graphite, titanium and restrained green.
   Keep actual code/math monospace; all interface and editorial copy share one sans. */
#root :is(.customer-home,.customer-service,.editorial-page,.program-page,.paper-page,.legal-page,.preview-consultation-page,.charter-page,.jcee-editorial) :is(h1,h2,h3,h4,h5,h6,p,li,dd,dt,small,a,button,label,input,textarea,select,summary,figcaption,blockquote,th,td,span,em,strong):not(pre *,code *,math *,svg *) {
  font-family:var(--worldlab-font) !important;
}
#root :is(.editorial-page,.program-page,.paper-page,.legal-page,.charter-page,.jcee-editorial) :is(h2,h3,h4,h5,h6) {
  text-shadow:none !important; font-weight:600 !important; letter-spacing:-.025em !important;
}
#root :is(.editorial-page,.program-page,.paper-page,.legal-page,.charter-page) h1 {
  text-shadow:0 1px 1px #142c2812,0 3px 5px #142c281a !important;
}
#root :is(.editorial-page,.program-page,.paper-page,.legal-page,.charter-page) :is(.editorial-kicker,.eyebrow,.research-status-line,.program-number,.section-index,.status-label,.research-topic-nav a) {
  font-size:12px !important; line-height:1.6 !important; letter-spacing:.09em !important; font-weight:600;
}
#root :is(.editorial-page,.program-page,.paper-page,.legal-page,.charter-page) :is(p,li) { line-height:1.75; }
#root .editorial-page .editorial-masthead {
  grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:48px;
  padding-block:64px 72px; border-bottom:1px solid var(--jcee-line);
}
#root .editorial-page .editorial-masthead h1 {
  font-size:clamp(38px,4.6vw,66px); line-height:1.06;
  letter-spacing:-.035em !important; text-wrap:balance; margin:22px 0 28px;
}
#root .editorial-page .editorial-deck { max-width:48ch; font-size:clamp(17px,1.45vw,20px); line-height:1.7; }
#root .editorial-page .editorial-masthead[data-long-title] h1 { font-size:clamp(34px,3.5vw,50px); line-height:1.12; }
#root .editorial-page .editorial-hero-art {
  display:block; width:100%; height:auto; max-height:none; aspect-ratio:3/2;
  object-fit:cover; filter:none; mix-blend-mode:normal; mask-image:none;
  border-radius:4px; box-shadow:0 18px 48px #0004; transform:none; animation:none;
}
#root .editorial-page .editorial-section-muted {
  background:var(--worldlab-surface) !important;
  border-block:1px solid var(--jcee-line);
}
#root .editorial-page .editorial-section h2 { max-width:26ch; font-size:clamp(28px,3vw,42px); line-height:1.15; }
#root .editorial-page .resource-card h3 { font-size:23px; line-height:1.25; }
#root .editorial-page :is(.research-topic-row,.editorial-link-list a) { transition:background-color .18s ease,border-color .18s ease; }
#root .editorial-page :is(.research-topic-row,.editorial-link-list a):hover { background:#172218; border-color:var(--worldlab-bronze) !important; }
#root .editorial-page :is(.research-topic-index,.research-topic-arrow,.binding-strip li::after) { color:var(--worldlab-bronze) !important; }
#root .editorial-page .binding-note { border-color:var(--worldlab-bronze) !important; }
#root .editorial-page :is(.editorial-link-list,.publication-toc nav,.publication-toc-downloads) { border-color:var(--jcee-line) !important; }
#root .editorial-page .research-topic-nav { gap:10px 22px; padding-block:20px; }
#root .editorial-page .research-topic-nav a { padding-block:8px; letter-spacing:.02em !important; text-transform:none; }
#root .editorial-page .research-topic-nav a[aria-current="page"] { color:var(--jcee-ink) !important; text-decoration-thickness:2px; }
/* Closing sections retain the shared dark surface. */
#root .editorial-page .editorial-section-dark {
  background:var(--jcee-ink) !important; color:var(--jcee-paper) !important;
  padding-block:72px; border:0;
}
#root .editorial-page .editorial-section-dark :is(h2,h3,p,a) { color:var(--jcee-paper) !important; }
#root .editorial-page .editorial-section-dark .editorial-kicker { color:var(--wl-green) !important; }
#root .editorial-page .editorial-section-dark .editorial-button { background:var(--jcee-paper) !important; color:var(--jcee-ink) !important; border-color:var(--jcee-paper) !important; }
#root .editorial-page .editorial-section-dark :is(a,button):focus-visible { outline-color:var(--wl-green); }
#root .editorial-page .editorial-section-dark :is(.research-question,.research-question *,.research-identity-grid > div,.editorial-text-link) { color:var(--jcee-paper) !important; border-color:var(--jcee-line) !important; }
#root .editorial-page .research-field-card li::before { color:var(--worldlab-bronze); }
#root .program-page :is(h2,h3):not(.qcs-gate *,.durability-console *) { font-size:clamp(26px,3vw,42px) !important; line-height:1.18 !important; }
#root .program-page .registry-entry h3 { font-size:clamp(24px,2.5vw,36px) !important; }
#root .program-page .program-links { flex-wrap:wrap; justify-content:flex-start; gap:16px 24px; margin-top:32px; border-color:var(--jcee-line) !important; }
#root .program-page .program-links a { flex:0 1 240px; min-width:0; overflow-wrap:normal; line-height:1.65; color:var(--worldlab-bronze) !important; }
#root .program-page .registry-jump-links a { color:var(--jcee-ink) !important; border-color:var(--jcee-line); }
#root .program-page .eyebrow > span { background:var(--worldlab-bronze) !important; }
#root .editorial-page .editorial-button { border-radius:5px; text-shadow:none; }
#root .brand-footer { background:var(--worldlab-surface) !important; border-color:var(--jcee-line); }
#root .brand-footer .brand-footer-wordmark { text-shadow:none !important; }
@media(max-width:900px) {
  #root .editorial-page .editorial-masthead { gap:28px; grid-template-columns:minmax(0,1fr) minmax(0,.85fr); }
}
@media(max-width:700px) {
  #root .editorial-page .editorial-masthead { grid-template-columns:1fr; padding-block:40px; }
  #root .editorial-page .editorial-hero-art { max-width:none; width:100%; max-height:320px; object-fit:cover; }
  #root .editorial-page .editorial-section-dark { padding-block:44px; }
  #root .editorial-page .editorial-masthead h1 { margin-block:18px 22px; }
}
@media(prefers-reduced-motion:reduce) {
  #root .editorial-page :is(.research-topic-row,.editorial-link-list a) { transition:none; }
}

/* Product and partnership introductions use the same material composition. */
#root .program-page .worldlab-masthead,
#root .customer-service .worldlab-service-masthead {
  display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr);
  align-items:center; gap:48px; max-width:1440px; margin-inline:auto;
  padding:64px clamp(22px,5vw,72px) 72px !important;
  border-bottom:1px solid var(--jcee-line); min-height:0 !important;
}
#root .worldlab-masthead-copy { min-width:0; }
#root .worldlab-masthead-art {
  display:block; width:100%; height:auto; aspect-ratio:3/2; object-fit:cover;
  border-radius:4px; box-shadow:0 18px 48px #0004;
}
#root .program-page .worldlab-masthead h1,
#root .customer-service .worldlab-service-masthead h1 {
  font-size:clamp(38px,4.3vw,62px) !important; line-height:1.08 !important;
  letter-spacing:-.035em !important; margin:22px 0 28px; max-width:20ch;
}
#root .program-page .worldlab-masthead .program-number { margin-top:18px; font-family:var(--worldlab-font) !important; }
#root .program-page .worldlab-masthead .program-deck { max-width:48ch !important; font-size:18px !important; line-height:1.7 !important; margin:0 !important; }
#root .program-page .program-status-row {
  display:flex; flex-wrap:wrap; gap:12px 28px; padding:20px 0 0;
  margin-top:28px; background:transparent !important; backdrop-filter:none;
  border-color:var(--jcee-line) !important; font-size:11px; line-height:1.65; letter-spacing:.06em;
}
#root .program-page .program-status-row > span { min-width:0; }
#root .program-page .worldlab-masthead .program-links { margin-top:24px; }
#root .program-page .worldlab-masthead .program-links a { flex-basis:auto; font-size:12px; }
#root .program-page .program-masthead:not(.worldlab-masthead) h1 { max-width:24ch; font-size:clamp(38px,4.6vw,66px) !important; }
#root .program-page > section:not(.program-masthead) { padding-block:64px; }
#root .program-page :is(.partner-engagement-model,.registry-classifications,.program-next) {
  background:var(--worldlab-surface) !important; border-block:1px solid var(--jcee-line) !important;
}
#root .program-page :is(.partner-shared-layout,.partner-sequence,.partner-pathway,.partner-pathway-card,.program-next) :is(strong,p,li,span) { color:var(--jcee-ink) !important; }
#root .program-page :is(.partner-signal-grid article > span,.partner-sequence > li > span,.partner-kicker,.partner-form-route) { color:var(--worldlab-bronze) !important; }
#root .program-page :is(.partner-signal-grid,.partner-sequence,.partner-inquiry-copy dl) :is(article,li,div) { border-color:var(--jcee-line) !important; }
#root .program-page :is(.partner-pathway-card h3,.partner-fit-intro h2) { font-size:clamp(28px,3vw,42px) !important; }
/* Reading pages keep a quiet measure; links and emphasis stay distinct. */
#root :is(.paper-page,.charter-page) :is(.paper-masthead,.charter-masthead) { padding:64px clamp(22px,5vw,72px) !important; }
#root .paper-page .paper-masthead h1 { font-size:clamp(40px,5vw,68px); line-height:1.08; }
#root :is(.paper-page,.charter-page) :is(.paper-deck,.charter-deck) { max-width:58ch; font-size:20px; line-height:1.7; }
#root :is(.paper-page,.charter-page) :is(.paper-markdown,.charter-document) { font-size:17px; line-height:1.8; }
#root :is(.paper-page,.charter-page) :is(.paper-markdown,.charter-document) h2 { font-size:clamp(28px,3vw,40px); line-height:1.2; }
#root :is(.paper-page,.charter-page) :is(.paper-markdown,.charter-document) h3 { font-size:24px; line-height:1.3; }
#root :is(.paper-page,.charter-page) :is(.paper-sidebar,.charter-toc) { border-color:var(--jcee-line); }
#root .legal-page main { padding:64px clamp(22px,5vw,72px) 80px; }
#root .legal-page main > div { max-width:800px; }
#root .legal-page h1 { font-size:clamp(38px,4.6vw,66px); line-height:1.1; margin-bottom:24px; }
#root .legal-page h2 { font-size:24px; line-height:1.3; }
#root .legal-page strong { color:var(--jcee-ink) !important; }
#root .legal-page a:not(.site-header a,.brand-footer a) { color:var(--worldlab-bronze) !important; text-underline-offset:4px; }
#root .publication-pdf-preview { margin-top:24px; padding:20px; background:var(--worldlab-surface); border:1px solid var(--jcee-line); }
#root .publication-pdf-preview summary { cursor:pointer; color:var(--jcee-ink); font-weight:600; }
#root .publication-pdf-preview[open] summary { margin-bottom:20px; }
#root .publication-pdf-preview summary:focus-visible { outline:3px solid var(--worldlab-bronze); outline-offset:6px; }
/* Inquiry surfaces: clear labels, calm panels, one evergreen primary action. */
#root .preview-consultation-page h1 { font-size:clamp(38px,4.6vw,66px) !important; line-height:1.08; text-shadow:0 1px 1px #142c2812,0 3px 5px #142c281a !important; }
#root .preview-consultation-page :is(h2,h3) { font-weight:600 !important; text-shadow:none !important; }
#root .preview-consultation-page h2 { font-size:clamp(28px,3vw,42px); line-height:1.2; }
#root .preview-consultation-page h3 { font-size:22px; line-height:1.3; }
#root .preview-consultation-page :is(.preview-kicker,.preview-panel-top,.preview-call-process > li > span,.preview-services-grid > article > span) { color:var(--worldlab-bronze) !important; }
#root .preview-consultation-page :is(.preview-consult-form,.preview-draft-review) { background:var(--worldlab-surface) !important; border:1px solid var(--jcee-line) !important; border-radius:6px; box-shadow:none; padding:32px !important; }
#root :is(.preview-consultation-page,.partner-page) :is(input,textarea,select) { border:1px solid #526558 !important; border-radius:4px; padding:13px 14px; font-size:16px; }
#root :is(.preview-consultation-page,.partner-page) :is(input,textarea)::placeholder { color:var(--jcee-muted); opacity:1; }
#root .preview-consultation-page .preview-button { background:var(--jcee-ink) !important; color:var(--jcee-paper) !important; border-color:var(--jcee-ink) !important; border-radius:4px; }
#root .preview-consultation-page :is(.preview-secondary-button,.preview-text-link) { color:var(--jcee-ink) !important; border-color:var(--jcee-line) !important; }
#root .preview-consultation-page :is(.preview-draft-review pre,.preview-existing-inquiry) { background:var(--jcee-paper) !important; color:var(--jcee-ink) !important; }
/* Legacy capability templates share the same graphite surface and artwork. */
#root .jcee-editorial { --paper:var(--jcee-paper); --paper-light:var(--jcee-paper); --dark:var(--jcee-ink); --font-display:var(--worldlab-font); --font-body:var(--worldlab-font); }
#root .jcee-editorial .detail-hero { grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:48px; padding-block:64px 72px; }
#root .jcee-editorial .detail-hero h1 { font-size:clamp(38px,4.6vw,66px); line-height:1.08; letter-spacing:-.035em; }
#root .jcee-editorial .detail-aside { padding:0; border:0; background:transparent; }
#root .jcee-editorial .detail-aside > .worldlab-masthead-art { margin-bottom:28px; }
#root .jcee-editorial .detail-aside h2 { font-size:24px; }
#root .jcee-editorial .detail-aside :is(p,li) { line-height:1.65; }
#root .jcee-editorial .cta { background:var(--worldlab-surface); }
#root .jcee-editorial .cta h2 { font-size:clamp(30px,3.4vw,48px); line-height:1.15; }
#root .jcee-editorial .button { border-radius:4px; }
#root .jcee-editorial .eyebrow { color:var(--worldlab-bronze); }
@media(max-width:900px) {
  #root .program-page .worldlab-masthead,
  #root .customer-service .worldlab-service-masthead,
  #root .jcee-editorial .detail-hero { gap:28px; }
}
@media(max-width:700px) {
  #root .program-page .worldlab-masthead,
  #root .customer-service .worldlab-service-masthead,
  #root .jcee-editorial .detail-hero { grid-template-columns:1fr; padding-block:40px !important; }
  #root .program-page > section:not(.program-masthead) { padding-block:40px; }
  #root .program-page .program-status-row { flex-direction:column; gap:12px; }
  #root .worldlab-masthead-art { max-height:320px; }
  #root .legal-page main { padding-block:40px 56px; }
}

#root :is(.program-page,.paper-page,.charter-page,.preview-consultation-page) :is(.program-number,.paper-code,.charter-code,.preview-panel-top,.section-index) { font-family:var(--worldlab-font) !important; }
#root .preview-consultation-page .preview-consult-form h2 { font-size:clamp(26px,2.5vw,34px); }
@media(max-width:700px) { #root .preview-consultation-page :is(.preview-consult-form,.preview-draft-review) { padding:24px !important; } }
#root .customer-service { background:var(--jcee-paper) !important; }
#root .customer-service :is(h2,h3) { text-shadow:none !important; font-weight:600; }
#root .customer-home :is(.customer-kicker,.customer-cards > article > span) { color:var(--worldlab-bronze) !important; }
#root .jcee-editorial { background:var(--jcee-paper) !important; }
#root .jcee-editorial .detail-hero { display:grid; align-items:center; }
#root .jcee-editorial .detail-copy h1 { margin:22px 0 28px; max-width:20ch; }
#root .jcee-editorial .detail-intro { font-size:18px; line-height:1.7; color:var(--jcee-muted); max-width:48ch; margin-bottom:28px; }

#root :is(.paper-page,.charter-page,.jcee-editorial) h1 em { font-family:inherit !important; font-weight:inherit !important; }
#root .paper-page .paper-masthead { min-height:0; }
#root .paper-page .paper-code { margin-top:24px; }
#root .paper-page .paper-masthead h1 { margin:22px 0 28px; }
#root .paper-page .paper-deck { margin:0; }
#root .paper-page .paper-masthead blockquote { margin:36px 0; padding-left:24px; max-width:38ch; font-size:clamp(24px,2.6vw,34px); line-height:1.4; border-left-width:3px; }
#root .paper-page .paper-version-row { max-width:900px; }

/* Homepage visual language shared by every public route. Operational/admin screens are excluded. */
#root#root#root :is(.customer-home,.customer-service,.editorial-page,.program-page,.paper-page,.legal-page,.preview-consultation-page,.charter-page,.jcee-editorial) {
 color-scheme:dark; background:var(--wl-bg)!important; color:var(--wl-ink);
 font-family:var(--worldlab-font); --customer-ink:var(--wl-ink); --customer-muted:var(--wl-muted); --customer-line:var(--wl-line);
 --paper:var(--wl-bg); --ink:var(--wl-ink); --muted:var(--wl-muted); --line:var(--wl-line);
 --editorial-paper:var(--wl-bg); --editorial-muted:var(--wl-muted); --editorial-line:var(--wl-line);
}
#root#root#root#root :is(.customer-home,.customer-service,.editorial-page,.program-page,.paper-page,.legal-page,.preview-consultation-page,.charter-page,.jcee-editorial) :is(h1,h2,h3,h4,h5,h6),
#root#root#root#root :is(.customer-home,.customer-service,.editorial-page,.program-page,.paper-page,.legal-page,.preview-consultation-page,.charter-page,.jcee-editorial) :is(h1,h2,h3,h4,h5,h6) :is(span,em,strong) {
 font-family:var(--wl-display)!important; font-weight:500!important; letter-spacing:-.045em!important; text-shadow:none!important; color:var(--wl-ink)!important;
}
#root#root#root .site-header { background:#080a09f5!important; border-color:var(--wl-line)!important; }
#root#root#root .site-header :is(a,button,summary,span) { color:var(--wl-ink)!important; font-family:var(--worldlab-font)!important; }
#root#root#root .site-header :is(.mobile-nav,.header-company-links) { background:var(--worldlab-surface)!important; border-color:var(--wl-line)!important; border-radius:0; }
#root#root#root .site-header :is(.mobile-nav a,.header-company-links a):hover { background:#1c291e; color:var(--wl-green)!important; }
#root#root#root .site-header :is(a,button,summary):focus-visible { outline:2px solid var(--wl-green); outline-offset:4px; }
#root#root#root .site-header .skip-link { background:var(--worldlab-surface); }
#root#root#root :is(.editorial-page,.program-page,.paper-page,.legal-page,.preview-consultation-page,.charter-page,.jcee-editorial,.customer-service) :is(p,li,dd,dt,small) { color:var(--wl-muted); }
#root#root#root :is(.editorial-page,.program-page,.paper-page,.legal-page,.preview-consultation-page,.charter-page,.jcee-editorial,.customer-service) :is(a,button,input,textarea,select,summary):focus-visible { outline:2px solid var(--wl-green)!important; outline-offset:5px; }
#root#root#root :is(.editorial-page,.program-page,.paper-page,.legal-page,.preview-consultation-page,.charter-page,.jcee-editorial,.customer-service) :is(input,textarea,select) { background:var(--worldlab-surface)!important; color:var(--wl-ink)!important; border-color:#526558!important; }
#root#root#root :is(.editorial-button,.preview-button,.customer-service .customer-button,.jcee-editorial .button) { background:var(--wl-green)!important; color:#182311!important; border-color:var(--wl-green)!important; box-shadow:none!important; border-radius:3px; }
#root#root#root :is(.editorial-button,.preview-button,.customer-service .customer-button,.jcee-editorial .button):hover { background:#ccffb7!important; color:#182311!important; }
#root#root#root .editorial-page .editorial-section-dark { background:var(--worldlab-surface)!important; color:var(--wl-ink)!important; }
#root#root#root .editorial-page .editorial-section-dark :is(p,a,.research-question,.research-question *,.research-identity-grid > div) { color:var(--wl-ink)!important; }
#root#root#root .editorial-page .editorial-section-dark .editorial-button { color:#182311!important; }
#root#root#root .resource-filters button { background:transparent; color:var(--wl-ink); border-color:var(--wl-line); }
#root#root#root .resource-filters button[aria-pressed="true"] { background:var(--wl-green); color:#182311; border-color:var(--wl-green); }
#root#root#root .brand-footer { background:var(--wl-bg)!important; color:var(--wl-ink)!important; }
#root#root#root .brand-footer :is(a,p,strong,span,small,div,em) { color:var(--wl-ink)!important; }
#root#root#root .brand-footer .brand-footer-links > div > span { color:var(--wl-green)!important; }
#root#root#root .brand-footer a:hover { color:var(--wl-green)!important; }
#root#root#root .paper-page :is(pre,.paper-sidebar) { background:var(--worldlab-surface); color:var(--wl-ink); }
#root#root#root .customer-service .customer-hero::before { display:none; }

#root#root#root .customer-service .customer-hero { background:var(--wl-bg)!important; }

#root#root#root :is(.editorial-page,.program-page,.paper-page,.legal-page,.preview-consultation-page,.charter-page,.jcee-editorial,.customer-service) :is(h1,h2,h3,h4,h5,h6) a { color:inherit!important; font-family:inherit!important; }
#root#root#root .preview-consultation-page .preview-boundary-note { background:var(--worldlab-surface)!important; color:var(--wl-muted)!important; border-color:var(--wl-line)!important; }
